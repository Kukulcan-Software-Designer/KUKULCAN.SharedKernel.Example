<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
      <TargetFramework>net10.0</TargetFramework>
      <LangVersion>latestmajor</LangVersion>
      <Nullable>enable</Nullable>
      <ImplicitUsings>enable</ImplicitUsings>
      <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
      <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
      <RootNamespace>KUKULCAN.SharedKernel.Example.WebApi</RootNamespace>
      <AssemblyName>KUKULCAN.SharedKernel.Example</AssemblyName>
      <SolutionDir>$(MSBuildThisFileDirectory)</SolutionDir>
      <BaseOutputPath>$(SolutionDir)Bin\$(MSBuildProjectName)\</BaseOutputPath>
      <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
    <PackageReference Include="KUKULCAN.SharedKernel" Version="1.0.0" />
    <PackageReference Include="KUKULCAN.SharedKernel.Auth" Version="1.1.6" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <ProjectReference Include="..\KUKULCAN.SharedKernel.Example.Application\KUKULCAN.SharedKernel.Example.Application.csproj" />
    <ProjectReference Include="..\KUKULCAN.SharedKernel.Example.Infrastructure\KUKULCAN.SharedKernel.Example.Infrastructure.csproj" />
    <ProjectReference Include="..\KUKULCAN.SharedKernel.Example.Migrations.PostgreSQL\KUKULCAN.SharedKernel.Example.Migrations.PostgreSQL.csproj" />
    <ProjectReference Include="..\KUKULCAN.SharedKernel.Example.Migrations.SQLServer\KUKULCAN.SharedKernel.Example.Migrations.SQLServer.csproj" />
    <ProjectReference Include="..\KUKULCAN.SharedKernel.Example.Migrations.MySQL\KUKULCAN.SharedKernel.Example.Migrations.MySQL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
</Project>
